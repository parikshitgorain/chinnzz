<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-tagline">{{ cms.site.footer.tagline }}</p>
        <ul class="footer-socials">
          <li><a href="{{ cms.site.kick.url }}" target="_blank" rel="noopener noreferrer">Kick</a></li>
          <li><a href="{{ cms.site.x.url }}" target="_blank" rel="noopener noreferrer">X</a></li>
          <li><a href="{{ cms.site.discord.url }}" target="_blank" rel="noopener noreferrer">Discord</a></li>
        </ul>
      </div>
      <div class="footer-legal">
        <p class="footer-disclosure">{{ cms.site.footer.disclosure }}</p>
        <p class="footer-age">{{ cms.site.footer.ageNotice }}</p>
        <ul class="footer-links">
          <li><a href="/responsible-gambling/">Responsible gambling and support</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <p>© <span id="year">2026</span> chinnzz. All rights reserved.</p>
      {% if cms.site.footer.builtBy %}<p class="footer-built">{{ cms.site.footer.builtBy }}</p>{% endif %}
    </div>
  </div>
</footer>
